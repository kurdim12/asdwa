{
  // Cloudflare Workers Static Assets config.
  // Deploy the static export (`out/`) with:  npm run cf:deploy
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mkurdi-website",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./out",
    // matches next.config trailingSlash: true  ->  /about  ->  /about/index.html
    "html_handling": "auto-trailing-slash",
    // serve the prebuilt 404 page for unknown paths
    "not_found_handling": "404-page"
  }
}
